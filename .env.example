# LAST-MILE DELIVERY TRACKER - ENV TEMPLATE

# Backend Configuration (.env in /backend)
# Core App Settings
PROJECT_NAME="Last-Mile Delivery Tracker"
API_V1_STR="/api/v1"
DEBUG=True
# Database Configuration (SQLite default, PostgreSQL supported)
DATABASE_URL="sqlite:///./delivery_tracker.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/delivery_tracker_db"
# Security & Authentication
SECRET_KEY="replace-this-with-a-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# CORS Configuration
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://your-frontend-app.vercel.app"
# Rate Calculation Defaults
VOLUMETRIC_FACTOR=5000.0
DEFAULT_COD_SURCHARGE_B2C=20.0
DEFAULT_COD_SURCHARGE_B2B=30.0
# Notification Providers
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@deliverytracker.com"
SMTP_PASSWORD="your-smtp-app-password"
EMAILS_FROM_EMAIL="noreply@deliverytracker.com"
EMAILS_FROM_NAME="Last-Mile Delivery Tracker"
# Notification Providers
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Frontend Configuration (.env in /frontend)
VITE_API_BASE_URL="http://localhost:8000/api/v1"
